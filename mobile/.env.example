# STYRA Mobile Application Environment Template
# Copy this file to mobile/.env for local development.
# IMPORTANT: Only variables prefixed with EXPO_PUBLIC_ are bundled into the app.

# ── Supabase Project Configuration ──
# Obtained from: Supabase Dashboard -> Project Settings -> API -> Project URL
# Required: YES
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Obtained from: Supabase Dashboard -> Project Settings -> API -> Project API keys (anon / public)
# Required: YES
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── STYRA Backend API Configuration ──
# Target URL of the STYRA FastAPI Server
# Options:
# - iOS Simulator / Web: http://localhost:8000
# - Android Emulator: http://10.0.2.2:8000
# - Production API: https://api.styra.app
# Required: YES
EXPO_PUBLIC_API_URL=http://localhost:8000
