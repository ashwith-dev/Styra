SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# AI Pipeline
TOGETHER_API_KEY=your-together-api-key
QWEN_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# Storage
STORAGE_BUCKET_ORIGINALS=clothing-originals
STORAGE_BUCKET_SEGMENTED=clothing-segmented
STORAGE_BUCKET_THUMBNAILS=clothing-thumbnails

# App
CORS_ORIGINS=*
MAX_IMAGE_SIZE_MB=10
MIN_IMAGE_RESOLUTION=500
LOG_LEVEL=INFO
APP_VERSION=0.1.0
API_PREFIX=

# Alembic migrations (direct Postgres connection, not the Supabase REST URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
