# STYRA FastAPI Server Environment Template
# Copy this file to backend/.env and populate with your server credentials.
# CRITICAL: This file contains server-side secrets. NEVER expose to mobile client or commit to git.

# ── Supabase Server Credentials ──
# Project URL (Supabase Dashboard -> Project Settings -> API)
# Required: YES
SUPABASE_URL=https://your-project.supabase.co

# Anon / Public Key (Supabase Dashboard -> Project Settings -> API -> anon public)
# Required: YES (Used for user-scoped PostgREST queries that enforce RLS)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (Supabase Dashboard -> Project Settings -> API -> service_role secret)
# Required: YES (Admin-only operations: storage management, user provisioning)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# JWT Secret (Supabase Dashboard -> Project Settings -> API -> JWT Secret)
# Required: YES (Used to verify mobile client Bearer tokens)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── AI Vision-Language Pipeline ──
# OpenRouter API key for Qwen vision-language inference
# Required: NO (Optional; falls back to visual heuristics if missing)
OPENROUTER_API_KEY=your-openrouter-api-key
QWEN_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# ── Gemini Stylist (Native API) ──
# Google AI Studio / Vertex AI API key for Gemini outfit selection
# Required: NO (Optional; falls back to highest-scored candidate if missing)
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# ── Storage Buckets Configuration ──
# Required: NO (Defaults provided below)
STORAGE_BUCKET_ORIGINALS=clothing-originals
STORAGE_BUCKET_SEGMENTED=clothing-segmented
STORAGE_BUCKET_THUMBNAILS=clothing-thumbnails

# ── Server & CORS Security ──
# Required: NO (Defaults provided below)
CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:8000
MAX_IMAGE_SIZE_MB=10
MIN_IMAGE_RESOLUTION=500
LOG_LEVEL=INFO
APP_VERSION=0.1.0
API_PREFIX=/v1

# ── Alembic / Postgres Direct Database Connection ──
# Required: NO (Only needed for direct Alembic schema migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
